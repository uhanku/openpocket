{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRouter Spend",
  "version": "0.1.0",
  "identifier": "com.uhanku.openrouter-spend",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenRouter Spend",
        "width": 1180,
        "height": 620,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "center": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "OpenRouter spending monitor",
    "longDescription": "Desktop dashboard for OpenRouter daily spending and carried-forward compound budget.",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
